        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-api"
          },
          "expr": "rate(ilv_llm_duration_seconds_sum[15m]) / rate(ilv_chat_requests_total[15m])",
          "legendFormat": "Génération (s)"
