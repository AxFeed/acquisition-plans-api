{
  "uid": "acquisition-plans-api",
  "title": "acquisition-plans-api : API et modèle de langage",
  "description": "Compteurs exposés par /metrics et collectés par Prometheus ; mêmes seuils que supervision/prometheus/alertes.yml.",
  "tags": [
    "acquisition-plans-api"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API disponible",
      "description": "État de la cible Prometheus. Alerte ApiIndisponible après 1 minute hors ligne.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-api"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-api"
          },
          "expr": "up{job=\"acquisition_plans_api\"}",
          "legendFormat": "API",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "En ligne",
                  "color": "#1d4ed8"
                },
                "0": {
                  "text": "Hors ligne",
                  "color": "#b45309"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1d4ed8",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Questions au modèle sur 1 h",
      "description": "Nombre de questions reçues par POST /api/chat sur la dernière heure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-api"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-api"
          },
          "expr": "increase(ilv_chat_requests_total[1h])",
          "legendFormat": "Questions",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1d4ed8",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Réponses sans le modèle sur 1 h",
      "description": "Réponses données avec les seuls extraits, le modèle n'ayant pas répondu. Alerte ReponsesSansModele dès la première sur 15 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-api"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-api"
          },
          "expr": "increase(ilv_chat_fallback_total[1h])",
          "legendFormat": "Sans le modèle",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1d4ed8",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requêtes refusées (4xx) sur 1 h",
      "description": "Jeton absent ou faux, saisie invalide, route inconnue : des refus, pas des pannes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-api"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-api"
          },
          "expr": "increase(ilv_http_client_errors_total[1h])",
          "legendFormat": "Refus 4xx",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1d4ed8",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requêtes HTTP par minute",
      "description": "Débit de l'API, moyenne sur 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-api"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-api"
          },
          "expr": "rate(ilv_http_requests_total[5m]) * 60",
          "legendFormat": "Requêtes par minute"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#1d4ed8"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1d4ed8",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Taux d'erreurs serveur (5xx) sur 15 min",
      "description": "Part des réponses 5xx sur 15 minutes. Ligne orange : seuil de 5 % de l'alerte TauxErreursServeur (5 minutes au-dessus).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-api"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-api"
          },
          "expr": "100 * rate(ilv_http_errors_total[15m]) / rate(ilv_http_requests_total[15m])",
          "legendFormat": "Erreurs 5xx (%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#1d4ed8"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1d4ed8",
                "value": null
              },
              {
                "color": "#b45309",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latence moyenne de génération sur 15 min",
      "description": "Durée moyenne de génération par question. Ligne orange : seuil de 25 s de l'alerte GenerationLente (5 minutes au-dessus).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-api"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
